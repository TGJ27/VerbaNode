VERBANODE_HOST=0.0.0.0
VERBANODE_PORT=8002
VERBANODE_PIN=CHANGE_ME
VERBANODE_DB_PATH=data/verbanode.db
VERBANODE_BACKUP_PATH=backups
VERBANODE_RECOVERY_BACKUP_RETENTION_COUNT=10
VERBANODE_OLLAMA_URL=http://127.0.0.1:11434
VERBANODE_DEFAULT_MODEL=qwen3.5:0.8b
VERBANODE_DEFAULT_LOCATION=Jakarta
VERBANODE_DEFAULT_TIMEZONE=Asia/Jakarta
VERBANODE_FUNASR_MODEL=iic/SenseVoiceSmall
VERBANODE_SAMPLE_RATE=16000
VERBANODE_SILENCE_MS=900
VERBANODE_MAX_RECORD_SECONDS=30
VERBANODE_POST_TTS_MIC_GUARD_MS=500
VERBANODE_BARGE_IN_START_DELAY_MS=800
VERBANODE_KOKORO_DIR=models/kokoro/kokoro-int8-multi-lang-v1_1
VERBANODE_KOKORO_THREADS=2
VERBANODE_OPEN_BROWSER=true
VERBANODE_TTS_CACHE_PATH=data/tts_cache

# Controller authentication hardening
VERBANODE_LOGIN_MAX_ATTEMPTS=5
VERBANODE_LOGIN_ATTEMPT_WINDOW_SECONDS=60
VERBANODE_LOGIN_LOCKOUT_BASE_SECONDS=5
VERBANODE_LOGIN_LOCKOUT_MAX_SECONDS=60
VERBANODE_WEBSOCKET_TICKET_TTL_SECONDS=15


# Trusted local external plugins
VERBANODE_EXTERNAL_PLUGINS_PATH=plugins
VERBANODE_PLUGIN_EXECUTION_TIMEOUT_SECONDS=10
VERBANODE_PLUGIN_FAILURE_THRESHOLD=3
VERBANODE_PLUGIN_MAX_CONCURRENT_EXECUTIONS=4
VERBANODE_PLUGIN_SHUTDOWN_TIMEOUT_SECONDS=5
VERBANODE_PLUGIN_MANIFEST_MAX_BYTES=65536
VERBANODE_PLUGIN_ENTRY_MAX_BYTES=2097152
VERBANODE_CAPABILITY_AUDIT_PATH=logs/capability-actions.jsonl

# Capability provider boundary (future robot/display/camera/serial/MQTT services)
VERBANODE_CAPABILITY_EXECUTION_TIMEOUT_SECONDS=10
VERBANODE_CAPABILITY_CANCEL_TIMEOUT_SECONDS=2
VERBANODE_CAPABILITY_PROVIDER_SHUTDOWN_TIMEOUT_SECONDS=5
VERBANODE_CAPABILITY_MAX_CONCURRENT_EXECUTIONS=4
VERBANODE_CAPABILITY_PROVIDER_MAX_CONCURRENT_EXECUTIONS=2
VERBANODE_CAPABILITY_MAX_ARGUMENTS_BYTES=65536
VERBANODE_CAPABILITY_DEFAULT_TTL_SECONDS=30
VERBANODE_CAPABILITY_MAX_TTL_SECONDS=300

# Phase 1 reliability controls
VERBANODE_STT_TIMEOUT_SECONDS=30
VERBANODE_STT_RETRY_COUNT=1
VERBANODE_OLLAMA_CONNECT_TIMEOUT_SECONDS=5
VERBANODE_OLLAMA_READ_TIMEOUT_SECONDS=120
VERBANODE_TOOL_TIMEOUT_SECONDS=12
VERBANODE_MAX_TOOL_ROUNDS=3
VERBANODE_TTS_EDGE_TIMEOUT_SECONDS=12
VERBANODE_TTS_RETRY_COUNT=1
VERBANODE_TTS_CIRCUIT_OPEN_SECONDS=60
VERBANODE_TTS_TEXT_QUEUE_SIZE=8
VERBANODE_TTS_AUDIO_QUEUE_SIZE=4

# Phase 2 isolated Audio Engine
VERBANODE_AUDIO_ENGINE_PROCESS=true
VERBANODE_AUDIO_ENGINE_STARTUP_TIMEOUT_SECONDS=8
VERBANODE_AUDIO_ENGINE_COMMAND_TIMEOUT_SECONDS=15
VERBANODE_AUDIO_ENGINE_WATCHDOG_SECONDS=3

# Phase 3 isolated AI Engine
VERBANODE_AI_ENGINE_PROCESS=true
VERBANODE_AI_ENGINE_STARTUP_TIMEOUT_SECONDS=10
VERBANODE_AI_ENGINE_COMMAND_TIMEOUT_SECONDS=45
VERBANODE_AI_ENGINE_WATCHDOG_SECONDS=3
VERBANODE_AI_ENGINE_ASR_QUEUE_SIZE=2
VERBANODE_AI_ENGINE_KOKORO_QUEUE_SIZE=4
VERBANODE_AI_ENGINE_PRELOAD_ASR=true
VERBANODE_AI_ENGINE_PRELOAD_KOKORO=true
VERBANODE_AI_ENGINE_KOKORO_TIMEOUT_SECONDS=60

# Set automatically by launcher.py in normal source/packaged HTTPS startup
# VERBANODE_SSL_CERTFILE=certs/verbanode-local-ca.crt
# VERBANODE_SSL_KEYFILE=certs/verbanode-local-ca.key
